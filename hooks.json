{
  "sdlc": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT:-$HOME/.gemini/config/plugins/sdlc}/hooks/sdlc.mjs\" start antigravity",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT:-$HOME/.gemini/config/plugins/sdlc}/hooks/sdlc.mjs\" guard antigravity",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT:-$HOME/.gemini/config/plugins/sdlc}/hooks/sdlc.mjs\" verify antigravity",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
